# Requires: source tools/kos/environ.sh
TARGET = loader.elf
OBJS = main.o handoff.o shim_blob.o bios_data.o splash_blob.o
CFLAGS += -I../shims/include -I../build
BIOS = ../bios/naomi/epr-21576h.ic27   # Flycast default Japan bios0 (gitignored ROM)
all: ../build/1ST_READ.BIN
include $(KOS_BASE)/Makefile.rules
$(TARGET): $(OBJS)
	kos-cc -o $(TARGET) $(OBJS)
# main.c #includes ../build/patch_table.h (generated by scripts/build_patch_table.py)
# and shim_iface.h. KOS Makefile.rules has no header-dependency tracking, so declare
# both explicitly: without this a header change (new patch addresses, new CART_FAD)
# would NOT rebuild main.o and the loader would silently keep the stale values
# (bit us in B5: CART_FAD change didn't take until an unrelated main.c edit).
main.o: ../build/patch_table.h ../shims/include/shim_iface.h
# patch_table.h resolves shim symbol ADDRESSES from shim.map; a shim rebuild moves
# every symbol, so the table must regenerate whenever the map changes. Running the
# generator before `make -C shims` shipped a table pointing into the middle of moved
# functions (2026-07-21: deterministic mid-print wedge in Flycast, self-inflicted).
../build/patch_table.h: ../shims/build/shim.map ../scripts/build_patch_table.py
	cd .. && python3 scripts/build_patch_table.py
# shim.bin embedded as _shim_bin / _shim_bin_end (C's leading-underscore prefix;
# raw objcopy names verified with sh-elf-nm against the ../shims/build/shim.bin path).
shim_blob.o: ../shims/build/shim.bin
	sh-elf-objcopy -I binary -O elf32-shl -B sh4 \
	  --redefine-sym _binary____shims_build_shim_bin_start=_shim_bin \
	  --redefine-sym _binary____shims_build_shim_bin_end=_shim_bin_end \
	  $< $@
# Naomi BIOS slices concatenated: [0x7000 @0x60000][0x70 @0x1ffd00] (see shim_iface.h).
# Extracted from the gitignored ROM at build time; build/ is gitignored (no ROM in git).
../build/bios_data.bin: $(BIOS)
	mkdir -p ../build
	dd if=$(BIOS) bs=1 skip=393216 count=28672 2>/dev/null > $@    # 0x60000 +0x7000
	dd if=$(BIOS) bs=1 skip=2096384 count=112 2>/dev/null >> $@    # 0x1ffd00 +0x70
# Embedded as _bios_data / _bios_data_end (C's leading-underscore prefix).
bios_data.o: ../build/bios_data.bin
	sh-elf-objcopy -I binary -O elf32-shl -B sh4 \
	  --redefine-sym _binary____build_bios_data_bin_start=_bios_data \
	  --redefine-sym _binary____build_bios_data_bin_end=_bios_data_end \
	  $< $@
# Boot splash: the real Naomi BIOS logo frame, captured from Flycast running
# the Naomi BIOS (scripts/capture_naomi_splash.sh). splash.png is gitignored
# (BIOS-rendered output, same category as the BIOS ROM) -- regenerate it with
# the capture script if missing. sips is stock macOS; converter is stdlib-only.
../build/splash.bin: splash.png ../scripts/bmp2rgb565.py
	mkdir -p ../build
	sips -s format bmp splash.png --out ../build/splash.bmp > /dev/null
	python3 ../scripts/bmp2rgb565.py ../build/splash.bmp $@
splash_blob.o: ../build/splash.bin
	sh-elf-objcopy -I binary -O elf32-shl -B sh4 \
	  --redefine-sym _binary____build_splash_bin_start=_splash_bin \
	  --redefine-sym _binary____build_splash_bin_end=_splash_bin_end \
	  $< $@
../build/1ST_READ.BIN: $(TARGET)
	mkdir -p ../build
	sh-elf-objcopy -R .stack -O binary $(TARGET) $@
clean:
	rm -f $(TARGET) $(OBJS) ../build/1ST_READ.BIN ../build/bios_data.bin
